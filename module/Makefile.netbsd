# The x86_64 implementations that use no vector unit, which the impl
# tables name whatever the toolchain, as Linux builds them.
.if ${MACHINE_ARCH} == "x86_64"
.PATH:	${SRCDIR}/icp/asm-x86_64/aes \
	${SRCDIR}/icp/asm-x86_64/sha2
SRCS+=	aes_impl_x86-64.c \
	aes_amd64.S \
	aeskey.c \
	sha256-x86_64.S \
	sha512-x86_64.S
.endif

# Common code FreeBSD takes from its own kernel instead.
SRCS+=	hkdf.c \
	zfs_crrd.c \
	zfs_debug_common.c \
	zio_crypt_os_icp.c
#zstd
SRCS+=	zfs_zstd.c
#zstd/common
SRCS+=	entropy_common.c \
	error_private.c \
	fse_decompress.c \
	pool.c \
	zstd_common.c \
#zstd/compress
SRCS+=	fse_compress.c \
	hist.c \
	huf_compress.c \
	zstd_compress.c \
	zstd_compress_literals.c \
	zstd_compress_sequences.c \
	zstd_compress_superblock.c \
	zstd_double_fast.c \
	zstd_fast.c \
	zstd_lazy.c \
	zstd_ldm.c \
	zstd_opt.c \
	zstd_preSplit.c
#zstd/decompress
SRCS+=	huf_decompress.c \
	zstd_ddict.c \
	zstd_decompress_block.c \
	zstd_decompress.c

# spa_history.c records the source's git revision, which the top-level
# build generates for Linux; here it is made in the object directory.
DPSRCS+=	zfs_gitrev.h
CLEANFILES+=	zfs_gitrev.h
zfs_gitrev.h:
	sh ${.CURDIR:H}/scripts/make_gitrev.sh ${.TARGET}

# zstd as Linux builds it (module/Kbuild.in): its upstream sources see
# the module's names through zstd_compat_wrapper.h, which also inlines
# xxhash, and none of its assembly, intrinsics or tracing.
ZSTD_UPSTREAM=	entropy_common.c error_private.c fse_decompress.c pool.c zstd_common.c fse_compress.c hist.c huf_compress.c zstd_compress.c zstd_compress_literals.c zstd_compress_sequences.c zstd_compress_superblock.c zstd_double_fast.c zstd_fast.c zstd_lazy.c zstd_ldm.c zstd_opt.c zstd_preSplit.c huf_decompress.c zstd_ddict.c zstd_decompress_block.c zstd_decompress.c
ZSTD_FLAGS=	-O3 -fno-tree-vectorize -U__BMI__ -DZSTD_DISABLE_ASM \
		-DZSTD_NO_INTRINSICS -DZSTD_TRACE=0
.for f in ${ZSTD_UPSTREAM}
CPPFLAGS.${f}+=	-include ${SRCDIR}/zstd/include/zstd_compat_wrapper.h
COPTS.${f}+=	${ZSTD_FLAGS} -Wno-error
.endfor
CPPFLAGS.zfs_zstd.c+=	-include ${SRCDIR}/zstd/include/zstd_compat_wrapper.h
COPTS.zfs_zstd.c+=	${ZSTD_FLAGS}

.include <bsd.kmodule.mk>
