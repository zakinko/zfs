# Build the kernel module for NetBSD.
#
#	make -f Makefile.netbsd S=/usr/src/sys
#
# NetBSD's own <bsd.kmodule.mk> does the work, as it does for every
# module in sys/modules; S names the kernel source it is built against.

SRCDIR=	${.CURDIR}
INCDIR=	${.CURDIR:H}/include

KMOD=	zfs

.PATH:	${SRCDIR}/avl \
	${SRCDIR}/lua \
	${SRCDIR}/nvpair \
	${SRCDIR}/icp \
	${SRCDIR}/icp/algs/aes \
	${SRCDIR}/icp/algs/blake3 \
	${SRCDIR}/icp/algs/edonr \
	${SRCDIR}/icp/algs/modes \
	${SRCDIR}/icp/algs/sha2 \
	${SRCDIR}/icp/algs/skein \
	${SRCDIR}/icp/api \
	${SRCDIR}/icp/core \
	${SRCDIR}/icp/io \
	${SRCDIR}/icp/spi \
	${SRCDIR}/os/bsd/spl \
	${SRCDIR}/os/bsd/zfs \
	${SRCDIR}/unicode \
	${SRCDIR}/zcommon \
	${SRCDIR}/zfs \
	${SRCDIR}/zstd \
	${SRCDIR}/zstd/lib/common \
	${SRCDIR}/zstd/lib/compress \
	${SRCDIR}/zstd/lib/decompress

CPPFLAGS+= -I${INCDIR}
CPPFLAGS+= -I${SRCDIR}/icp/include
CPPFLAGS+= -I${INCDIR}/os/bsd
CPPFLAGS+= -I${INCDIR}/os/bsd/spl
CPPFLAGS+= -I${INCDIR}/os/bsd/zfs
CPPFLAGS+= -I${SRCDIR}/zstd/include
CPPFLAGS+= -include ${INCDIR}/sys/simd_config.h
CPPFLAGS+= -include ${INCDIR}/os/bsd/spl/sys/ccompile.h
CPPFLAGS+= -D_KERNEL -D__KERNEL__ -DBUILDING_ZFS -DNDEBUG
# What configure defines for the userland build (config/always-system.m4).
CPPFLAGS+= -DSYSTEM_BSD -DSYSTEM_NETBSD
# What NetBSD's kernel has that the common code asks after.
CPPFLAGS+= -DHAVE_EXPLICIT_MEMSET

.if ${MACHINE_ARCH} == "i386" || ${MACHINE_ARCH} == "powerpc" || \
    ${MACHINE_ARCH:Mearm*} || ${MACHINE_ARCH:Mmips*} || \
    ${MACHINE_ARCH} == "sparc"
CPPFLAGS+= -DBITS_PER_LONG=32
.else
CPPFLAGS+= -DBITS_PER_LONG=64
.endif

#avl
SRCS+=	avl.c

# NetBSD's XDR, which libc and the kernel share; its own ZFS built it
# into the solaris module the same way.
.PATH:	${S}/../common/lib/libc/rpc
SRCS+=	xdr.c \
	xdr_array.c \
	xdr_mem.c

#os/bsd/spl
SRCS+=	acl_common.c \
	list.c \
	spl_kmem.c \
	spl_kstat.c \
	spl_misc.c \
	spl_policy.c \
	spl_procfs_list.c \
	spl_sysctl.c \
	spl_taskq.c \
	spl_uio.c \
	spl_zlib.c

#os/bsd/zfs
SRCS+=	abd_os.c \
	arc_os.c \
	kmod_core.c \
	spa_os.c \
	sysctl_os.c \
	vdev_disk.c \
	vdev_label_os.c \
	zfs_debug.c \
	zfs_file_os.c \
	zfs_acl.c \
	zfs_ctldir.c \
	zfs_dir.c \
	zfs_ioctl_os.c \
	zfs_racct.c \
	zfs_vfsops.c \
	zfs_vnops_os.c \
	zfs_znode_os.c \
	zvol_os.c

#nvpair
SRCS+=	fnvpair.c \
	nvpair.c \
	nvpair_alloc_fixed.c \
	nvpair_alloc_spl.c

#zcommon
SRCS+=	cityhash.c \
	zfeature_common.c \
