#icp/algs/edonr
SRCS+=	edonr.c
#icp/algs/sha2
SRCS+=	sha256_impl.c \
	sha2_generic.c \
	sha512_impl.c
# The illumos crypto framework, which encryption goes through here as
# on Linux: FreeBSD's kernel has a framework of its own, NetBSD's
# opencrypto(9) another, and this one is the module's own.
SRCS+=	illumos-crypto.c \
	aes_impl.c \
