# spa_history.c records the source's git revision, which the top-level
# build generates for Linux; here it is made in the object directory.
DPSRCS+=	zfs_gitrev.h
CLEANFILES+=	zfs_gitrev.h
zfs_gitrev.h:
	sh ${.CURDIR:H}/scripts/make_gitrev.sh ${.TARGET}

.include <bsd.kmodule.mk>
